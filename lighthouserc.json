{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8001/",
        "http://127.0.0.1:8001/login",
        "http://127.0.0.1:8001/status",
        "http://127.0.0.1:8001/blog",
        "http://127.0.0.1:8001/groups/solar-installers-network",
        "http://127.0.0.1:8001/industries/solar",
        "http://127.0.0.1:8001/industries/solar/tx/austin",
        "http://127.0.0.1:8001/t/lone-star-solar",
        "http://127.0.0.1:8001/find-a-pro"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "server-response-time": [
          "error",
          {
            "maxNumericValue": 600
          }
        ],
        "document-title": "error",
        "meta-description": "error",
        "http-status-code": "error",
        "link-text": "error",
        "crawlable-anchors": "error",
        "image-alt": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
