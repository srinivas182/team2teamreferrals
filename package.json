{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run tokens && vite build && vite build --ssr",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css",
        "types": "tsc --noEmit",
        "test": "vitest run",
        "tokens": "node scripts/build-tokens.mjs",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build -o storybook-static"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@storybook/addon-a11y": "10.6.6",
        "@storybook/react-vite": "10.6.6",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "axe-core": "4.14.0",
        "concurrently": "^10.0.3",
        "eslint": "10.14.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "jsdom": "31.0.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "3.9.10",
        "prettier-plugin-tailwindcss": "0.8.1",
        "storybook": "10.6.6",
        "tailwindcss": "^4.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "^8.0.0",
        "vitest": "5.1.0",
        "vitest-axe": "0.1.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@inertiajs/react": "3.11.0",
        "@laravel/passkeys": "0.4.1",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-dropdown-menu": "2.2.1",
        "@radix-ui/react-popover": "1.3.1",
        "@radix-ui/react-slot": "1.5.0",
        "@radix-ui/react-tooltip": "1.4.1",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "1.1.1",
        "laravel-echo": "^2.6.3",
        "lucide-react": "1.70.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sonner": "2.0.8",
        "tailwind-merge": "3.7.0"
    }
}
