# The server's .env (Sprint 54a). Copy this, fill in the <...> values, and paste the whole thing into the GitHub
# secret ENV_FILE (Settings → Environments → production → Environment secrets). The deploy writes it to the server.
# Don't commit a filled-in copy anywhere. Values marked (setup) come from the server set-up script's output.
#
# Most providers (Stripe, email sending, SMS, AI, Google/Microsoft sign-in, file storage) are set in the app itself
# under Admin → System → Providers after the first deploy, not here.

APP_NAME="Team to Team Referrals"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<(setup)>
APP_URL=https://<your domain, e.g. teamtoteamreferrals.com>
T2T_DOMAIN=<your domain, without https://>

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info

# DigitalOcean Managed MySQL: Databases → t2t-db → Connection details (choose "Connection parameters").
DB_CONNECTION=mysql
DB_HOST=<private host, e.g. private-t2t-db-do-user-123-0.k.db.ondigitalocean.com>
DB_PORT=25060
DB_DATABASE=t2t
DB_USERNAME=t2t
DB_PASSWORD=<the t2t user's password>

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=phpredis

MERCURE_JWT_SECRET=<(setup)>
MEILISEARCH_KEY=<(setup)>

CLAMAV_HOST=clamav
ATTACHMENTS_REQUIRE_SCAN=true

# Sending email: until a provider is chosen in Admin → System → Providers, mail is only written to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@<your domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Search engines: true on production only once you're ready to be found; always false on staging.
SEO_CANONICAL_URL=https://<your domain>
SEO_INDEXABLE=false
SEO_FORCE_CANONICAL=true

# Error tracking (optional until you have a Sentry account).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Backups: the Spaces bucket in the other region. Spaces Object Storage → Access Keys.
BACKUP_BUCKET=t2t-backups
BACKUP_S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
BACKUP_S3_KEY=<Spaces access key>
BACKUP_S3_SECRET=<Spaces secret key>
BACKUP_PASSPHRASE=<(setup); also keep it in your password manager>
# The private-files bucket (the same one set in Admin → System → Providers → File storage), mirrored nightly.
FILES_BUCKET=t2t-files
FILES_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Alerts from the server's health watch: an email address, and optionally a Slack, Discord or Teams webhook URL.
ALERT_EMAIL=<where alerts go>
NOTIFY_WEBHOOK_URL=

# Rarely needed (leave commented out):
# BACKUP_S3_PROVIDER=DigitalOcean   # another S3-compatible service for backups (e.g. AWS, Minio)
# T2T_HEALTH_SKIP=                  # health checks to leave out, comma-separated (e.g. scanner on a server without ClamAV)
# T2T_TLS=                          # "internal": Caddy's own certificate (a test server with no public domain)
# T2T_DB_CA=                        # set empty only for a database without TLS (never on DigitalOcean)
# T2T_COMPOSE_EXTRA=                # extra compose files, e.g. compose.cpanel.yaml (see env.cpanel.example)
# T2T_CADDYFILE=                    # Caddyfile.proxy behind another web server (cPanel's Apache)
# T2T_HTTP_BIND=                    # where Caddy listens for http, e.g. 127.0.0.1:8088 behind Apache (default 80)
# T2T_HTTPS_BIND=                   # where Caddy listens for https (default 443)
