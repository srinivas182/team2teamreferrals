# The front door (Sprint 54a). Cloudflare sits in front; Caddy terminates TLS with the Cloudflare origin certificate
# (or, before Cloudflare is set up, a Let's Encrypt certificate it gets by itself) and passes requests to Octane.
{
	servers {
		# Only Cloudflare may tell us the visitor's IP; anyone else's X-Forwarded-For is replaced. Per-IP rate limits
		# and sign-in lockouts depend on this. Ranges: https://www.cloudflare.com/ips/
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(app) {
	import /etc/caddy/tls.caddy
	encode zstd gzip

	# Real-time updates (Mercure, server-sent events): never buffered.
	handle /.well-known/mercure* {
		reverse_proxy {
			dynamic a web 8000 {
				refresh 1s
			}
			flush_interval -1
		}
	}

	handle {
		reverse_proxy {
			# Every running web container (two for a moment during a deploy); only healthy ones get traffic,
			# and a request that can't reach one is retried on another for up to 15 seconds.
			dynamic a web 8000 {
				refresh 1s
			}
			lb_policy round_robin
			lb_try_duration 15s
			lb_try_interval 250ms
			health_uri /up
			health_interval 2s
			health_timeout 3s
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}

{$T2T_DOMAIN} {
	import app
}

www.{$T2T_DOMAIN} {
	import /etc/caddy/tls.caddy
	redir https://{$T2T_DOMAIN}{uri} permanent
}
