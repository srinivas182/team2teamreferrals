# The front door (Sprint 54a), when Caddy faces the internet: Cloudflare sits in front; Caddy terminates TLS with the
# Cloudflare origin certificate (or, before Cloudflare is set up, a Let's Encrypt certificate it gets by itself) and
# passes requests to Octane. Behind another web server (cPanel's Apache), Caddyfile.proxy is used instead.
{
	servers {
		# Only Cloudflare (and the server itself) may tell us the visitor's IP; read right to left so a visitor
		# can't put a fake one in front. Per-IP rate limits and sign-in lockouts depend on this.
		# Ranges: https://www.cloudflare.com/ips/
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$T2T_DOMAIN} {
	import /etc/caddy/tls.caddy
	import /etc/caddy/app.caddy
}

www.{$T2T_DOMAIN} {
	import /etc/caddy/tls.caddy
	redir https://{$T2T_DOMAIN}{uri} permanent
}
