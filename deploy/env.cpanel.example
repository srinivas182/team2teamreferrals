# The server's .env on a cPanel server (Sprint 54a: the demo before DigitalOcean). Copy this, fill in the <...>
# values, and paste the whole thing into the GitHub secret ENV_FILE (Settings → Environments → production). Values
# marked (setup) come from the output of server-setup-cpanel.sh. Don't commit a filled-in copy anywhere.

APP_NAME="Team to Team Referrals"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<(setup)>
APP_URL=https://teamtoteamreferrals.com
T2T_DOMAIN=teamtoteamreferrals.com

# The cPanel set-up: Apache in front (it has the certificate), MySQL inside Docker, no virus scanner.
T2T_COMPOSE_EXTRA=compose.cpanel.yaml
T2T_CADDYFILE=Caddyfile.proxy
T2T_HTTP_BIND=127.0.0.1:8088
T2T_HTTPS_BIND=127.0.0.1:8443
T2T_DB_CA=
T2T_CLAMAV_HOST=
T2T_HEALTH_SKIP=scanner
ATTACHMENTS_REQUIRE_SCAN=false

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info

# The app's own database, inside Docker (created on the first deploy).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=t2t
DB_USERNAME=t2t
DB_PASSWORD=<(setup)>
T2T_MYSQL_ROOT_PASSWORD=<(setup)>

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=phpredis

MERCURE_JWT_SECRET=<(setup)>
MEILISEARCH_KEY=<(setup)>

# Email: written to the log until a provider is set in Admin → System → Providers.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@teamtoteamreferrals.com"
MAIL_FROM_NAME="${APP_NAME}"

# A demo: keep search engines out until launch.
SEO_CANONICAL_URL=https://teamtoteamreferrals.com
SEO_INDEXABLE=false
SEO_FORCE_CANONICAL=true

# Error tracking (Sentry), once you have the key (the "DSN").
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Backups: off until there's a Spaces bucket (DigitalOcean). Fill these in then; see deploy/env.example.
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_PASSPHRASE=<(setup)>
FILES_BUCKET=
FILES_S3_ENDPOINT=

# Alerts from the server's health watch.
ALERT_EMAIL=<where alerts go>
NOTIFY_WEBHOOK_URL=
