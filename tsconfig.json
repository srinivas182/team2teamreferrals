{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["vite/client", "node"],
        "paths": { "@/*": ["./resources/js/*"] }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vite.config.ts", "vitest.config.ts", ".storybook/*.ts", ".storybook/*.tsx"]
}
